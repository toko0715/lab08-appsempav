<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Biblioteca</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-dark mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Biblioteca</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-controls="menu" aria-expanded="false" aria-label="Abrir menú"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav">
                        <li class="nav-item"><a class="nav-link" asp-controller="Libros" asp-action="Index">Libros</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Socios" asp-action="Index">Socios</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Prestamos" asp-action="Reporte">Reporte de préstamos</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main class="container pb-5">
        @if (TempData["Mensaje"] is string mensaje)
        {
            <div class="alert alert-success" role="status">@mensaje</div>
        }
        @RenderBody()
    </main>
    <footer class="border-top py-3 text-muted"><div class="container">Biblioteca · Laboratorio 08 · MVC con Dapper</div></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
