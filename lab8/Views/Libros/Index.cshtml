@model IEnumerable<Libro>
@{ ViewData["Title"] = "Libros"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Libros activos</h1><a class="btn btn-primary" asp-action="Create">Nuevo libro</a></div>
<form method="get" asp-action="Index" class="row g-2 mb-4">
    <div class="col-sm-8"><label for="titulo" class="form-label">Buscar por título</label><input id="titulo" name="titulo" value="@ViewData["Busqueda"]" class="form-control" maxlength="200" /></div>
    <div class="col-sm-4 d-flex align-items-end gap-2"><button class="btn btn-primary">Buscar</button><a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a></div>
</form>
<div class="table-responsive"><table class="table table-striped align-middle">
    <thead><tr><th>Título</th><th>Autor</th><th>ISBN</th><th>Ejemplares</th><th>Acciones</th></tr></thead>
    <tbody>
    @foreach (var libro in Model) { <partial name="_FilaLibro" model="libro" /> }
    @if (!Model.Any()) { <tr><td colspan="5">No hay libros que coincidan con la búsqueda.</td></tr> }
    </tbody>
</table></div>
