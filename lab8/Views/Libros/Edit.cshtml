@model Libro
@{ ViewData["Title"] = "Editar libro"; }
<h1>Editar libro</h1>
<form asp-action="Edit" asp-route-id="@Model.LibroId" method="post" class="col-lg-7 bg-white p-4 border rounded">
    <input asp-for="LibroId" type="hidden" />
    <partial name="_Formulario" model="Model" />
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
