@model Libro
@{ ViewData["Title"] = "Detalle del libro"; }
<h1>@Model.Titulo</h1>
<dl class="row"><dt class="col-sm-3">Autor</dt><dd class="col-sm-9">@Model.AutorNombre</dd><dt class="col-sm-3">ISBN</dt><dd class="col-sm-9">@(Model.ISBN ?? "Sin registrar")</dd><dt class="col-sm-3">Ejemplares</dt><dd class="col-sm-9">@Model.Ejemplares</dd></dl>
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.LibroId">Editar</a>
<a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
